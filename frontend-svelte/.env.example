# Copy to .env in this folder and fill in real values.
#
# Build-time only: Vite inlines these into `import.meta.env.*` when the
# bundle is built (`npm run build` / `vite build`), so they have no effect
# at container runtime — see docs/decisions/0002-build-time-api-url.md.
# For `npm run dev` this is loaded automatically too; no extra flags needed.

# The backend's API base URL.
VITE_API_BASE_URL=http://localhost:8080/api
