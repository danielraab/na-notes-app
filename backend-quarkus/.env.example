# Copy to .env in this folder and fill in real values.
#
# Read at process startup (AppConfig, plus a couple of Quarkus config
# properties bridged directly onto these same names in
# application.properties). Every backend implementation in this repository
# must accept these exact variable names — it's a cross-implementation
# contract (see /docs/adr/0011-per-implementation-env-files.md and
# /docs/adr/0005-csrf-and-cors.md) so swapping backends via
# docker-compose.yml's build.context doesn't mean re-deriving config.

# --- HTTP ---
LISTEN_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8080
# Used to build user-facing links in notification emails and public share URLs.
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# --- Session / CSRF ---
SESSION_SECRET=change-me-to-a-long-random-value
# Only needed when the frontend and backend are on different subdomains of
# the same parent domain in production (e.g. app.example.com/api.example.com).
# Set to the shared parent, e.g. ".example.com", so the session/csrf_token
# cookies (and the frontend JS that reads csrf_token) are visible on both
# hosts. Leave unset for same-host deployments and local dev.
COOKIE_DOMAIN=

# --- OIDC (generic, any standards-compliant provider) ---
OIDC_ISSUER_URL=https://accounts.google.com
OIDC_CLIENT_ID=change-me
OIDC_CLIENT_SECRET=change-me
OIDC_REDIRECT_URL=http://localhost:8080/api/auth/callback
OIDC_SCOPES=openid,profile,email

# --- SMTP (share/mention notifications) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="NA Notes <notes@example.com>"

# --- Database (ADR 0013) ---
# backend-quarkus supports SQLite only (see docs/decisions/0001-plain-jdbc-and-sqlite.md).
# A bare path, "sqlite://<path>", or "file:<path>" all open a SQLite file at
# <path> (default ./notes.db if unset). A "postgres://..." value is rejected
# at startup with a clear error, rather than silently ignored.
DATABASE_URL=/data/notes.db
