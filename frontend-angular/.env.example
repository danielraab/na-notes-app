# This file documents the one variable the Docker build reads
# (`docker build --build-arg NG_APP_API_BASE_URL=...`, see Dockerfile).
# There's nothing to `cp` to `.env` here — Angular's CLI doesn't load a
# `.env` file for `ng serve` the way Vite does for frontend-react/
# frontend-svelte. For local dev, copy
# src/environments/environment.example.ts to
# src/environments/environment.ts and edit apiBaseUrl there instead — see
# docs/decisions/0002-build-time-api-url.md.

# The backend's API base URL, baked in at Docker build time.
NG_APP_API_BASE_URL=http://localhost:8080/api
