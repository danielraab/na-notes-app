# Copy to .env and fill in real values. Shared by every backend so
# swapping implementations doesn't mean re-deriving configuration.

# --- OIDC (generic, any standards-compliant provider) ---
OIDC_ISSUER_URL=https://accounts.google.com
OIDC_CLIENT_ID=change-me
OIDC_CLIENT_SECRET=change-me
OIDC_REDIRECT_URL=http://localhost:8080/api/auth/callback
OIDC_SCOPES=openid,profile,email

# --- Web / security ---
ALLOWED_ORIGINS=http://localhost:5173
SESSION_SECRET=change-me-to-a-long-random-value
PUBLIC_BASE_URL=http://localhost:8080
# Used to build user-facing links in notification emails and public share URLs.
FRONTEND_URL=http://localhost:5173

# --- SMTP (share/mention notifications) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="NA Notes <notes@example.com>"

# --- Database ---
DATABASE_PATH=/data/notes.db

# --- Frontend build-time config ---
VITE_API_BASE_URL=http://localhost:8080/api
